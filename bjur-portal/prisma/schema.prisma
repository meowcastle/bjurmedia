datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // file:/data/bjur.db
}

generator client {
  provider = "prisma-client-js"
}

// ── Orgs & users ───────────────────────────────────────────
model Client {
  id             String          @id @default(cuid())
  name           String // "SSH", "57.NYC", "SUYINSAMA", "Halcyon Films"
  username       String          @unique // login handle for the org
  status         ClientStatus    @default(ACTIVE)
  accentColor    String? // hex, e.g. "#ec3013" — overrides the default brand red in this client's portal. Null = default.
  logoUrl        String? // brand logo, admin-set — null = initials fallback
  // approval policy. Required by default: publishing to a client's own channels
  // without their sign-off is the failure nobody forgives.
  // Draft captions from the audio. Off by default: this sends the client's audio to a
  // third party, which is a decision to make per client rather than a default.
  autoCaption    Boolean         @default(false)
  /**
   * This client's house style, in their own words — structure, tone, sign-off, hashtag
   * habits. Fed to the drafter as instructions. Without it the model writes generic
   * social copy that reads like nobody in particular.
   */
  captionStyle   String?
  createdAt      DateTime        @default(now())
  users          User[]
  projects       Project[]
  channel        ClientChannel?
  socialAccounts SocialAccount[]
  members        ClientMember[]
}

enum ProjectType {
  DELIVERY // a gallery of finished work
  CALENDAR // scheduled social posts, approved in Slack
  FILM // one piece, cut by cut, with timestamped notes from every reviewer
}

enum ClientStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String          @id @default(cuid())
  clientId           String? // null => staff/admin user
  client             Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  email              String          @unique
  passwordHash       String // argon2id
  role               Role            @default(VIEWER)
  isAdmin            Boolean         @default(false) // staff portal access
  notifyDelivery     Boolean         @default(true) // email me when new work is delivered
  notifyExpiry       Boolean         @default(true) // remind me before a gallery expires
  mustChangePassword Boolean         @default(false) // set on temp-password issuance (invite, seat add)
  deactivatedAt      DateTime? // access revoked by staff: sign-in blocked and hidden from the seat/admin lists, but the row (and every license, upload batch and submission pointing at it) is kept. Re-adding the same email reactivates this row.
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  sessions           Session[]
  favorites          Favorite[]
  projectMemberships ProjectMember[]
  submissions        Submission[]
  uploadBatches      UploadBatch[]
  approvedAssets     Asset[]         @relation("AssetApprovals")
  reviewerSeats      Reviewer[]
  clientMemberships  ClientMember[]

  @@index([clientId])
}

enum Role {
  OWNER
  DOWNLOADER
  VIEWER
}

// ── Projects (galleries) ───────────────────────────────────
/**
 * A seat's membership of one client.
 * Replaces User.clientId as the authority on who can see whose work. One email can now
 * hold several — an agency producer working across accounts, or staff who need the
 * client's own view — and the role is per membership, so OWNER on one account and
 * VIEWER on another is expressible.
 * User.clientId is kept for now as the seat's original/primary client, but nothing reads
 * it for access decisions any more: two places to say who can see what is how the wrong
 * client's files end up on someone's screen.
 */
model ClientMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([clientId])
}

model Project {
  id        String @id @default(cuid())
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  path      String // relative to MEDIA_ROOT: CLIENT/PROJECT/DATE
  inboxSlug String @unique // folder name under INBOX_ROOT/<client.username>/<inboxSlug> — export destination for finals
  status    String @default("LIVE")

  /**
   * What this project is, fixed at creation. Replaced a row of independent booleans that
   * could each be flipped forever: a project that changed shape after files had landed
   * left assets behind that were ingested under the old rules, and no screen could say
   * which. Type is write-once — PATCH rejects a change to it.
   * Review used to be a separate boolean any project could carry. It is the FILM type now:
   * timestamped notes only make sense for one piece going through numbered cuts, and a
   * Delivery gallery of 60 clips had no coherent way to be "reviewed" at all.
   */
  type ProjectType @default(DELIVERY)

  /**
   * Payment hold — the only switch that still flips after creation, because it describes
   * where the job has got to rather than what the job is.
   * While it is on, everything the client can reach is watermarked: the gallery streams a
   * marked proxy and Download hands over a marked full-quality copy instead of the master.
   * Turning it off once payment clears releases the clean files instantly — both
   * renditions are already on disk, so nothing re-encodes at the one moment the client is
   * standing there waiting.
   */
  paymentHold       Boolean   @default(false)
  paymentReleasedAt DateTime? // when the hold was last lifted — the record of when they got clean files
  deliveredAt       DateTime?
  expiresAt         DateTime? // null => permanent (retainer)

  // Delivery-email debounce. Assets arrive one file at a time (ingest.ts runs per
  // file), so a 40-clip drop would be 40 emails. Instead each arrival pushes
  // deliveryPendingAt forward, and the worker only mails once nothing new has landed
  // for DELIVERY_QUIET_MS — one email describing the whole batch. Since marks where
  // the batch began, so the mail can summarise exactly what arrived in it.
  deliveryPendingSince DateTime?
  deliveryPendingAt    DateTime?
  deliveryNotifiedAt   DateTime?

  createdAt             DateTime            @default(now())
  assets                Asset[]
  members               ProjectMember[]
  folders               Folder[]
  submissions           Submission[]
  uploadBatches         UploadBatch[]
  submissionRequests    SubmissionRequest[]
  reviewers             Reviewer[]
  // Which reminder threshold has already gone out (14 or 3). Null = none yet, and it
  // resets whenever expiresAt moves, so extending a gallery re-arms both.
  expiryReminderSentFor Int?

  @@index([clientId])
}

// A row here restricts a login to specific projects at a specific per-project
// role, overriding User.role for that project. A login with zero rows is
// unrestricted — sees every LIVE project of its client, at User.role.
model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

// One level of client-facing sections within a project (e.g. "Ceremony",
// "Reception"). Deleting a folder un-assigns its assets (Asset.folderId ->
// null, shown as "Unsorted") rather than deleting them.
model Folder {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  assets    Asset[]

  @@unique([projectId, name])
  @@index([projectId])
}

// One upload session's worth of client-submitted files (a folder drop or a batch of
// picked files), grouped so they land in one human-readable, SMB-browsable folder
// instead of a flat bucket — see submissionRelPath() in src/lib/submissions.ts. label
// is the actual on-disk folder name under SUBMISSIONS_ROOT/<client>/<project>/.
/**
 * A "send us footage" link: one named request, one URL token, no login behind it.
 * Replaced Project.clientUploads. A boolean could only say "this project accepts files",
 * which meant one undifferentiated pile and no way to hand the link to a DP without also
 * handing them a seat. A request names what is wanted ("Berlin raws"), becomes the folder
 * the files land in, and can be closed once it has served its purpose.
 */
model SubmissionRequest {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String // "Berlin raws" — also the on-disk folder name
  token     String    @unique // URL token for /send/<projectSlug>/<name>-<token>
  expiresAt DateTime // default now + SUBMISSION_REQUEST_TTL_DAYS
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  batches UploadBatch[]

  @@index([projectId])
}

model UploadBatch {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Null for anyone who arrived through a send link. They have no account and never get
  // one — the point of a request is that a DP can send rushes without being given a seat.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  requestId String?
  request   SubmissionRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  /**
   * Optionally typed on the public send page: "Who's sending? — optional".
   */
  senderName String?

  label       String
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@index([projectId])
  @@index([requestId])
}

// A client-submitted raw file (camera originals, an NLE project file) for the studio
// to work from — the reverse direction of Asset (studio -> client). Deliberately kept
// separate from Asset/ingest.ts: these aren't classified, proxied, or ever shown back
// to a client as a deliverable — they just need to land durably and be downloadable
// by an admin. relPath is under SUBMISSIONS_ROOT, not MEDIA_ROOT.
model Submission {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Null for anything sent through a send link, for the same reason UploadBatch.userId
  // is: the sender has no account and never gets one. The batch carries the request it
  // arrived through, and that is what scopes it instead.
  userId        String?
  user          User?            @relation(fields: [userId], references: [id])
  batchId       String
  batch         UploadBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  relativePath  String // client-side folder-relative path, e.g. "A-Cam/GH010001.MP4" — preserved as-is under the batch's on-disk folder
  filename      String // display basename, the last segment of relativePath
  relPath       String
  sizeBytes     BigInt // declared total, from File.size at creation — the integrity target
  receivedBytes BigInt           @default(0) // bytes confirmed on disk — the resume checkpoint
  status        SubmissionStatus @default(UPLOADING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  completedAt   DateTime?

  @@index([projectId])
  @@index([userId])
  @@index([batchId])
}

enum SubmissionStatus {
  UPLOADING
  COMPLETE
  FAILED
}

// ── Assets (registered files) ──────────────────────────────
model Asset {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        AssetKind // PHOTO | VIDEO
  format      String // Still | Reel | Film | Master
  orientation String // landscape | portrait
  name        String // display filename
  relPath     String // path under MEDIA_ROOT (source of truth on disk)
  sizeBytes   BigInt
  dims        String? // "6048×4032"
  durationSec Int?
  masterCodec String? // "ProRes 422 HQ · 12.4 GB", "BRAW · 47.2 GB"

  // proxy / thumbnail pipeline
  proxyStatus   ProxyStatus @default(PENDING)
  proxyRelPath  String? // generated H.264 proxy
  thumbRelPath  String? // generated poster/thumbnail
  proxyRes      String? // "1080p H.264", "1080×1920 H.264", "watermarked 1080p"
  // 0-100 while an encode runs, null otherwise. Written from ffmpeg's own -progress
  // stream, so it is the encoder's position in the timeline rather than a guess from
  // output file size. A 22 GB ProRes master takes a quarter of an hour on this box, and
  // without this the only way to tell "working" from "hung" was to watch a file grow
  // over SSH.
  proxyProgress Int?

  // Watermarked renditions, generated only while the owning project sits on a payment
  // hold (Project.paymentHold). Kept *alongside* the clean ones rather than replacing
  // them, so lifting the hold is a flag flip rather than a re-encode of the whole
  // gallery. markStatus drives the worker exactly the way proxyStatus does.
  markStatus         MarkStatus @default(NONE)
  markedThumbRelPath String?
  markedProxyRelPath String?
  markedFileRelPath  String? // full-quality marked stand-in served in place of the master

  // re-upload tracking: an asset re-ingested at the same relPath replaces the
  // original in place (see ingest.ts) rather than duplicating — these track how
  // often and how recently that's happened, since a re-upload shortly after the
  // first one is the fingerprint of a canceled/redone upload worth a second look.
  reingestCount  Int       @default(0)
  lastReplacedAt DateTime?

  // visibility & licensing
  internal Boolean @default(false) // studio working master — hidden from clients

  // grouping (57.NYC IG workflow)
  weekOf DateTime?

  // client-facing section within the project — null = Unsorted
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // weekly Slack content-calendar text (57.NYC IG workflow)
  contentTitle String? // "TOVA (FAM ONLY)" — guest/topic + collab tag line
  caption      String? // IG & YT caption body (or IG-only body when captionYT is set)
  captionYT    String? // set only when YT copy differs from IG — null in the common case

  // publishing (Phase 1). publishAt is the exact post datetime and is separate from
  // weekOf, which stays what it was: the grouping key the calendar and the weekly Slack
  // post read. Overloading weekOf for both would have made "which week is this in" and
  // "when exactly does it go out" the same field, and they are not.
  // Transcription and the caption draft that comes from it. Only ever set on assets
  // ingested after the feature existed — nothing backfills the library.
  transcript       String?
  transcriptStatus TranscriptStatus @default(NONE)
  transcriptError  String?
  transcribedAt    DateTime?
  /**
   * HUMAN once a person edits the caption, which takes the draft warning off.
   */
  captionSource    CaptionSource    @default(HUMAN)

  publishAt         DateTime?
  publishIg         Boolean      @default(false)
  publishYt         Boolean      @default(false)
  collaborators     String? // JSON string[] of IG handles
  publishState      PublishState @default(NONE)
  approvedById      String?
  approvedBy        User?        @relation("AssetApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  /**
   * Staff signed off the caption. A week cannot be pushed with unapproved captions.
   */
  captionApprovedAt DateTime?
  /**
   * When this asset's week was pushed to Slack.
   */
  postedToSlackAt   DateTime?
  publishAttempts   Int          @default(0)
  publishError      String?
  igMediaId         String?
  ytVideoId         String?

  createdAt   DateTime     @default(now()) // "Added"
  updatedAt   DateTime     @updatedAt // "Updated"
  favorites   Favorite[]
  socialPosts SocialPost[]
  reviews     Review[]

  @@index([projectId])
  @@index([folderId])
  // The publisher and the auto-approve sweep both scan by state and due time.
  @@index([publishState, publishAt])
  @@index([transcriptStatus])
}

enum AssetKind {
  PHOTO
  VIDEO
}

enum ProxyStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// NONE = this asset has no marked renditions and needs none (its project is not on a
// payment hold). Anything else mirrors ProxyStatus.
enum MarkStatus {
  NONE
  PENDING
  GENERATING
  READY
  FAILED
}

// ── Licensing (BRAW) ───────────────────────────────────────
// ── Favorites, sessions, activity ──────────────────────────
/**
 * One round of client feedback on one cut.
 * A row per asset version, so a re-upload starts a new round rather than overwriting the
 * note left on the previous one — "what did they say about v1" has to survive v2
 * landing.
 */
/**
 * One row = one cut.
 * A cut is created unsent when its export lands, and nobody is emailed until the studio
 * has answered every note on the cut before it. That gap is the whole point of sentAt:
 * the old model mailed the client the moment a file appeared, so notes could arrive
 * against a cut the studio had not finished responding to.
 */
model Review {
  id           String       @id @default(cuid())
  assetId      String
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version      Int          @default(1)
  /**
   * The studio's note to the client, shown beside the cut.
   */
  note         String?
  state        ReviewState  @default(PENDING)
  /**
   * null = uploaded but not yet released to reviewers. At most one sent PENDING cut.
   */
  sentAt       DateTime?
  /**
   * The owner seat who approved. A Reviewer, not a User: guests can never approve.
   */
  approvedById String?
  approvedBy   Reviewer?    @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  /**
   * Set when the next cut is sent.
   */
  supersededAt DateTime?
  createdAt    DateTime     @default(now())
  notes        ReviewNote[]

  @@index([assetId])
  @@index([state])
}

enum ReviewState {
  PENDING
  APPROVED
  SUPERSEDED
}

/**
 * Someone entitled to watch the cuts and leave notes.
 * Seats are mirrored from ClientMember — every role, not just owners, because a producer
 * who can only view files still has notes worth hearing. Guests are the reason this model
 * exists at all: a director or a label gets a link, gives a name once, and never has an
 * account or a way to download anything.
 */
model Reviewer {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         ReviewerKind
  /**
   * SEAT only: the client seat this mirrors. SetNull so deleting a user keeps the notes.
   */
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  /**
   * Guests are asked once on first visit; seats carry the user's name.
   */
  name         String
  /**
   * Free label shown beside the name: "Director", "Label".
   */
  role         String?
  /**
   * GUEST only: 32 url-safe bytes behind /r/<token>. Hex, not base64url — a hyphen in a
   * token broke the send-link URL split once already.
   */
  token        String?      @unique
  lastOpenedAt DateTime?
  /**
   * Revoked guests 404; deactivated seats are revoked rather than deleted.
   */
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  notes        ReviewNote[]
  approved     Review[]     @relation("ApprovedBy")

  @@unique([projectId, email])
  @@index([projectId])
}

enum ReviewerKind {
  SEAT
  GUEST
}

/**
 * One note, pinned to a moment in a cut.
 * Drafts are server-side so they survive a reload or a move between devices, and they are
 * private until their author sends a batch. The privacy rule is load-bearing: no admin
 * query may ever return a note with sentAt = null. Studio surfaces may count a reviewer's
 * drafts to show "watched · drafting", never read them.
 */
model ReviewNote {
  id         String       @id @default(cuid())
  reviewId   String
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   Reviewer     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  /**
   * video.currentTime when the composer was focused. null = a general note, no marker.
   */
  timeSec    Float?
  body       String
  /**
   * null = draft, visible to its author alone. Sent notes are immutable.
   */
  sentAt     DateTime?
  outcome    NoteOutcome?
  /**
   * The studio's one line, which reviewers read in the next cut's email.
   */
  response   String?
  answeredAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([reviewId])
  @@index([reviewerId])
}

enum NoteOutcome {
  CHANGED
  KEPT
}

model Favorite {
  userId  String
  assetId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([userId, assetId])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique // hash of the session cookie value
  device         String // "Chrome · macOS"
  ip             String?
  location       String? // resolved from IP
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  // Which client this session is currently viewing, for a seat that belongs to more
  // than one. Held on the session rather than the user so switching is per-device and
  // never mutates the account.
  activeClientId String?

  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  actor     String // "SSH", "You", "Worker", client name
  action    String // human-readable line
  meta      String? // JSON blob
  createdAt DateTime @default(now())
}

// Singleton row the worker process touches every poll tick, so the admin
// dashboard's "worker online" status reflects a real liveness check.
model WorkerHeartbeat {
  id       Int      @id @default(1)
  lastSeen DateTime @default(now())
}

// ── Integrations ───────────────────────────────────────────
model SlackConfig {
  id             Int     @id @default(1) // singleton row
  connected      Boolean @default(false)
  workspace      String?
  webhookUrl     String?
  defaultChannel String  @default("#client-deliveries")
  autoUpload     Boolean @default(true)
  autoDownload   Boolean @default(false)
  autoSubmission Boolean @default(true)
}

model ClientChannel {
  clientId String @id
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel  String // "#ssh-deliveries" (empty => use default)
}

// ── Social insights (weekly IG/YouTube view counts) ────────
/**
 * NONE      nothing scheduled
 * DRAFT     scheduled, not yet sent to the client
 * AWAITING  client has been asked; auto-approves at approvalDueAt unless held
 * APPROVED  cleared to publish
 * PUBLISHING/PUBLISHED/FAILED  the worker's own states
 */
enum PublishState {
  NONE
  DRAFT
  AWAITING
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  /**
   * Caption approved by staff; the week can be pushed to Slack.
   */
  READY
  /**
   * Included in a week pushed to Slack. Terminal for calendar work — Slack is
   * push-only here, so nothing comes back to move it on.
   */
  POSTED
}

/**
 * NONE      never queued — everything that predates this feature, and anything not
 * eligible (stills, masters, internal work)
 * PENDING   waiting for the worker
 * RUNNING   claimed
 * DONE      transcript stored
 * NO_SPEECH the audio carried no usable dialogue — a music bed, room tone, silence
 * FAILED    see transcriptError
 */
enum TranscriptStatus {
  NONE
  PENDING
  RUNNING
  DONE
  NO_SPEECH
  FAILED
}

/**
 * Who wrote the caption currently in the field. AI copy stays visibly unreviewed.
 */
enum CaptionSource {
  HUMAN
  AI
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
}

model SocialAccount {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  externalId     String // IG Business Account ID, or YouTube Channel ID
  handle         String // "@ssh_studio" — display only
  accessToken    String? // IG long-lived token; null for YouTube (uses SocialConfig.youtubeApiKey)
  tokenExpiresAt DateTime? // IG long-lived tokens expire in 60 days; staff alert under 10
  refreshToken   String? // YouTube OAuth refresh token
  lastSyncedAt   DateTime?
  lastSyncError  String?
  posts          SocialPost[]

  @@unique([clientId, platform])
}

model SocialPost {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?        @relation(fields: [assetId], references: [id])
  externalPostId  String        @unique // IG media id / YouTube video id
  permalink       String?
  caption         String?
  postedAt        DateTime
  viewCount       Int           @default(0)
  matchConfidence String? // "auto" | "manual" | null (unmatched)
  lastFetchedAt   DateTime      @default(now())

  @@index([assetId])
  @@index([socialAccountId])
}

model SocialConfig {
  id            Int     @id @default(1) // singleton row
  youtubeApiKey String?
}
